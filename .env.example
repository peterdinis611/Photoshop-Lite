# Photoshop Lite API
PORT=3001

# Server-side AI keys (never commit real values)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REMOVE_BG_API_KEY=

# Optional — full Google Fonts catalog (otherwise curated fallback list)
GOOGLE_FONTS_API_KEY=

# Local projects / assets storage (defaults to apps/api/data)
# Layout: DATA_DIR/workspaces/{X-Workspace-Id}/projects|assets
DATA_DIR=

# Public site origin for SEO (canonical, Open Graph, sitemap, robots)
# Used at editor build / dev via Vite. No trailing slash.
VITE_SITE_URL=https://photoshoplite.app
