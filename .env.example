# Photoshop Lite API
PORT=3001

# Server-side AI keys (never commit real values)
# Without REPLICATE_API_TOKEN, cloud Lab jobs (style, face-restore, object-remove,
# caption, segment, inpaint) will fail — local Revive/Clean/Relight/Cutout/Upscale still work.
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REMOVE_BG_API_KEY=

# Optional — full Google Fonts catalog (otherwise curated fallback list)
GOOGLE_FONTS_API_KEY=

# Stock photos (optional — Openverse works without keys)
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Local projects / assets storage (defaults to apps/api/data)
# Layout: DATA_DIR/workspaces/{X-Workspace-Id}/projects|assets
DATA_DIR=

# Public site origin for SEO (canonical, Open Graph, sitemap, robots)
# Used at editor build / dev via Vite. No trailing slash.
VITE_SITE_URL=https://photoshoplite.app

# API rate limits (Nest Throttler — per IP, TTL window in ms)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AI_LIMIT=20
THROTTLE_STOCK_LIMIT=60
