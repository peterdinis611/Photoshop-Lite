# Photoshop Lite API
PORT=3001

# Server-side AI keys (never commit real values)
# Without REPLICATE_API_TOKEN, cloud Lab jobs (style, face-restore, object-remove,
# caption, segment, inpaint) will fail — local Revive/Clean/Relight/Cutout/Upscale still work.
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REMOVE_BG_API_KEY=

# Optional — full Google Fonts catalog (otherwise curated fallback list)
GOOGLE_FONTS_API_KEY=

# Stock photos (optional — Openverse works without keys)
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Hugging Face Inference — fallback when REPLICATE_API_TOKEN is unset
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Free / freemium AI providers (optional fallbacks) ─────────────
# fal.ai — fast SDXL/FLUX inpaint + ESRGAN upscale + rembg
# https://fal.ai/dashboard/keys
FAL_KEY=

# Together AI — text→image for Generative Fill prompts
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Fireworks AI — text→image fallback
# https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Clipdrop (Stability) — cleanup / uncrop / reimagine
# https://clipdrop.co/apis
CLIPDROP_API_KEY=

# DeepAI — colorize, super-res, toonify style
# https://deepai.org/dashboard/profile
DEEPAI_API_KEY=

# PhotoRoom — cutout alternative to remove.bg
# https://app.photoroom.com/api-dashboard
PHOTOROOM_API_KEY=

# Local projects / assets storage (defaults to apps/api/data)
# Layout: DATA_DIR/workspaces/{X-Workspace-Id}/projects|assets
DATA_DIR=

# Redis — shared cache + rate-limit storage across API instances
# Leave unset to use in-memory (single process). Start local: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379

# Public site origin for SEO (canonical, Open Graph, sitemap, robots)
# Used at editor build / dev via Vite. No trailing slash.
VITE_SITE_URL=https://photoshoplite.app

# API rate limits (Nest Throttler — keyed by X-Workspace-Id when present, else IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AI_LIMIT=20
THROTTLE_STOCK_LIMIT=60
THROTTLE_CATALOG_LIMIT=90
THROTTLE_READ_LIMIT=180

# Per-workspace storage caps (no login — soft multi-tenant isolation)
WORKSPACE_MAX_PROJECTS=50
WORKSPACE_MAX_ASSETS=100
WORKSPACE_MAX_BYTES=209715200

# Max concurrent AI upstream jobs on this API process
AI_MAX_CONCURRENT=8

# Comma-separated browser origins allowed to call the API (credentials enabled)
CORS_ORIGINS=http://localhost:4200

# JSON / urlencoded body size cap (DoS guard)
JSON_BODY_LIMIT=40mb
